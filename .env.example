# Copy to .env.local for local development.

# Backend wiring -----------------------------------------------------------
# When set, the app's /api/* routes proxy to the Laravel CRM backend and auth
# runs against its Sanctum tokens. Leave it unset to run on the built-in
# sample data (offline demo) with no backend.
CRM_API_BASE=http://127.0.0.1:8000/api

# Secret for signing the session cookie. Required in production; in dev a
# built-in fallback is used if this is omitted.
AUTH_SECRET=change-me

# Seller app: Help & support contacts ---------------------------------------
# Shown on /seller/help. Leave empty to show "contact your account manager"
# instead. Read at build time (NEXT_PUBLIC_), so rebuild after changing them.
NEXT_PUBLIC_SELLER_SUPPORT_PHONE=
NEXT_PUBLIC_SELLER_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SELLER_SUPPORT_EMAIL=

# Turn the offline service worker on in `next dev` (it is always on in
# production builds). Leave unset normally: dev files are not versioned.
# NEXT_PUBLIC_ENABLE_SW=1
